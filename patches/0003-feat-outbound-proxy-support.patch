index 00000000..e7f909f1
--- /dev/null
+++ b/apps/server/tests/system_proxy.rs
@@ -0,0 +1,83 @@
+use std::time::Duration;
+
+use orbit_server::sign_in_providers::{
+    Provider, ProviderClient, ProviderCredentials, ProviderEndpoints, ProviderFailure,
+};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::TcpListener;
+use tokio::time::timeout;
+
+#[tokio::test]
+async fn github_provider_uses_https_proxy_from_process_environment() {
+    // This integration-test binary has one test, so its process environment is isolated.
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let proxy = format!("http://{}", listener.local_addr().unwrap());
+    unsafe {
+        for name in [
+            "HTTP_PROXY",
+            "http_proxy",
+            "ALL_PROXY",
+            "all_proxy",
+            "NO_PROXY",
+            "no_proxy",
+        ] {
+            std::env::remove_var(name);
+        }
+        std::env::set_var("HTTPS_PROXY", &proxy);
+        std::env::set_var("https_proxy", &proxy);
+        std::env::set_var("NO_PROXY", "");
+        std::env::set_var("no_proxy", "");
+    }
+
+    let proxy_request = tokio::spawn(async move {
+        let (mut connection, _) = listener.accept().await.unwrap();
+        let mut headers = Vec::new();
+        let mut buffer = [0_u8; 1024];
+        loop {
+            let count = connection.read(&mut buffer).await.unwrap();
+            assert_ne!(count, 0, "proxy connection closed before request headers");
+            headers.extend_from_slice(&buffer[..count]);
+            if headers.windows(4).any(|window| window == b"\r\n\r\n") {
+                break;
+            }
+        }
+        let request_line = String::from_utf8_lossy(&headers)
+            .lines()
+            .next()
+            .unwrap()
+            .to_owned();
+        connection
+            .write_all(
+                b"HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\nConnection: close\r\n\r\n",
+            )
+            .await
+            .unwrap();
+        request_line
+    });
+
+    let client = ProviderClient::new(ProviderEndpoints::default());
+    let result = timeout(
+        Duration::from_secs(5),
+        client.profile(
+            Provider::Github,
+            &ProviderCredentials {
+                client_id: "test-client".to_owned(),
+                client_secret: "test-secret".to_owned(),
+                issuer: None,
+            },
+            "https://orbit.test/api/v1/auth/providers/github/callback",
+            "test-code",
+            "test-verifier",
+        ),
+    )
+    .await
+    .expect("GitHub provider request should go through the local proxy");
+    assert_eq!(result, Err(ProviderFailure::Unavailable));
+    assert_eq!(
+        timeout(Duration::from_secs(1), proxy_request)
+            .await
+            .expect("Reqwest should connect to the configured proxy")
+            .unwrap(),
+        "CONNECT github.com:443 HTTP/1.1"
+    );
+}
