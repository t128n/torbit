+#[tokio::test]
+async fn enrollment_refuses_bad_callers_and_bad_keys() {
+    let fixture = Fixture::new().await;
+    let (status, _) = fixture
+        .call(
+            None,
+            "POST",
+            "",
+            Some(json!({ "name": "x", "public_key": PUBLIC_KEY })),
+        )
+        .await;
+    assert_eq!(status, StatusCode::UNAUTHORIZED);
+
+    let guest = fixture.user("guest").await;
+    let (status, _) = fixture.enroll(&guest, "Laptop").await;
+    assert_eq!(status, StatusCode::NOT_FOUND);
+
+    for key in [
+        "",
+        "not base64!",
+        // base64 of 91 zero bytes: not a key
+        &"AAAA".repeat(30),
+    ] {
+        let (status, _) = fixture
+            .call(
+                Some(&fixture.owner.cookie),
+                "POST",
+                "",
+                Some(json!({ "name": "Laptop", "public_key": key })),
+            )
+            .await;
+        assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY, "key {key:?}");
+    }
+    let (status, _) = fixture
+        .call(
+            Some(&fixture.owner.cookie),
+            "POST",
+            "",
+            Some(json!({ "name": "  ", "public_key": PUBLIC_KEY })),
+        )
+        .await;
+    assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
+    assert!(!fixture.registry_path.exists());
+}
+
+#[tokio::test]
+async fn registry_writes_are_atomic_and_leave_no_temporary_files() {
+    let fixture = Fixture::new().await;
+    fixture.enroll(&fixture.owner, "One").await;
+    fixture.enroll(&fixture.owner, "Two").await;
+    let text = std::fs::read_to_string(&fixture.registry_path).unwrap();
+    let file: Value = serde_json::from_str(&text).unwrap();
+    assert_eq!(file["devices"].as_array().unwrap().len(), 2);
+    let names: Vec<_> = std::fs::read_dir(fixture.registry_path.parent().unwrap())
+        .unwrap()
+        .map(|entry| entry.unwrap().file_name().to_string_lossy().into_owned())
+        .collect();
+    assert_eq!(names, vec!["devices.json".to_owned()]);
+    // a registry replaced behind the server's back is read again
+    std::fs::write(&fixture.registry_path, r#"{"version":1,"devices":[]}"#).unwrap();
+    let (_, list) = fixture
+        .call(Some(&fixture.owner.cookie), "GET", "", None)
+        .await;
+    assert_eq!(list, json!([]));
+}
