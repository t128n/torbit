+
+#[tokio::test]
+async fn list_shows_only_the_callers_devices() {
+    let fixture = Fixture::new().await;
+    let member = fixture.user("member").await;
+    // a missing registry file means no devices
+    assert!(!fixture.registry_path.exists());
