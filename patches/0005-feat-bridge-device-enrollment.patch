+#[tokio::test]
+async fn the_dns_check_leaves_the_invalid_domain_verified() {
+    let fixture = Fixture::new().await;
+    fixture.enroll(&fixture.owner, "Laptop").await;
+    let domain_id: String =
+        sqlx::query_scalar("SELECT id FROM mail_domains WHERE name LIKE '%.bridge.invalid'")
+            .fetch_one(fixture.database.pool())
+            .await
+            .unwrap();
+    // an empty resolver: a real domain would lose its verify record and be suspended
+    let checker = DnsChecker::new(
+        Arc::clone(&fixture.mail),
+        Arc::new(FakeDns::new()),
+        None,
+        MailMode::Direct,
+    );
+    let day = 25 * 60 * 60 * 1000;
+    let now = TimestampMillis::from_millis(TimestampMillis::now().as_millis() + day);
+    let status = checker
+        .check_domain(domain_id.parse().unwrap(), now)
+        .await
+        .unwrap();
+    assert_eq!(status, Some(DomainStatus::Verified));
+    checker.check_due(now).await.unwrap();
+    let (status, suspended_at): (String, Option<i64>) =
+        sqlx::query_as("SELECT status, suspended_at FROM mail_domains WHERE id = $1")
+            .bind(&domain_id)
+            .fetch_one(fixture.database.pool())
+            .await
+            .unwrap();
+    assert_eq!(status, "verified");
+    assert_eq!(suspended_at, None);
+}
