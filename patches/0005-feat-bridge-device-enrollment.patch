+
+#[tokio::test]
+async fn revoke_marks_the_device_revoked_for_its_owner_and_for_admins() {
+    let fixture = Fixture::new().await;
+    let member = fixture.user("member").await;
+    let other = fixture.user("member").await;
+    let (_, mine) = fixture.enroll(&member, "Mine").await;
+    let id = mine["id"].as_str().unwrap();
+
+    // another member cannot see it, let alone revoke it
+    let (status, _) = fixture
+        .call(Some(&other.cookie), "DELETE", &format!("/{id}"), None)
+        .await;
+    assert_eq!(status, StatusCode::NOT_FOUND);
+    assert_eq!(
+        fixture
+            .registry
+            .lookup(id)
+            .await
+            .unwrap()
+            .unwrap()
+            .revoked_at,
+        None
+    );
+
+    // the owner of the device revokes it
+    let (status, _) = fixture
+        .call(Some(&member.cookie), "DELETE", &format!("/{id}"), None)
+        .await;
+    assert_eq!(status, StatusCode::NO_CONTENT);
+    let record = fixture.registry.lookup(id).await.unwrap().unwrap();
+    assert!(record.revoked_at.is_some());
+    let (_, list) = fixture.call(Some(&member.cookie), "GET", "", None).await;
+    assert!(list[0]["revoked_at"].is_string() || list[0]["revoked_at"].is_number());
+
+    // revoking again is fine and changes nothing
+    let (status, _) = fixture
+        .call(Some(&member.cookie), "DELETE", &format!("/{id}"), None)
+        .await;
+    assert_eq!(status, StatusCode::NO_CONTENT);
+
+    // a workspace admin revokes the device of another member
+    let (_, theirs) = fixture.enroll(&other, "Theirs").await;
+    let theirs = theirs["id"].as_str().unwrap();
+    let (status, _) = fixture
+        .call(
+            Some(&fixture.owner.cookie),
+            "DELETE",
+            &format!("/{theirs}"),
+            None,
+        )
+        .await;
+    assert_eq!(status, StatusCode::NO_CONTENT);
+    assert!(
+        fixture
+            .registry
+            .lookup(theirs)
+            .await
+            .unwrap()
+            .unwrap()
+            .revoked_at
+            .is_some()
+    );
+    // an unknown device
+    let (status, _) = fixture
+        .call(
+            Some(&member.cookie),
+            "DELETE",
+            &format!("/{}", Id::new_v7()),
+            None,
+        )
+        .await;
+    assert_eq!(status, StatusCode::NOT_FOUND);
+}
