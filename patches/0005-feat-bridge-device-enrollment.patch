@@ -0,0 +1,381 @@
+//! Worbit bridge devices: the device registry file and the destination a device delivers to.
+//!
+//! The registry is one JSON file (`ORBIT_MAIL_BRIDGE_REGISTRY_PATH`): a device id, the device's
+//! P-256 public key (SPKI DER, base64) and the mailbox address its mail goes to. It is written
+//! atomically (a temporary file in the same directory, then a rename) and read again on every
+//! call, so a missing file means no devices and a file replaced by hand is picked up. The delivery
+//! endpoint (`POST /api/v1/mail/inbound/bridge/{device_id}`) uses [`BridgeRegistry::lookup`].
+//!
+//! Each workspace gets one verified domain `<workspace id without hyphens>.bridge.invalid` (the
+//! name is unique across the instance, so it holds the workspace id) and each enrolled user a
+//! personal mailbox on it, unless the user has a personal mailbox already. No DNS is involved: the
+//! DNS check skips `.invalid` names.
+
+use std::io::Write as _;
+use std::path::{Path, PathBuf};
+
+use base64::Engine as _;
+use base64::engine::general_purpose::STANDARD;
+use orbit_platform::{Database, Id, TimestampMillis};
+use rand_core::RngCore as _;
+use serde::{Deserialize, Serialize};
+use sqlx::Row as _;
+use thiserror::Error;
+use tokio::sync::Mutex;
+
+use crate::repositories::membership;
+
+/// The suffix of the reserved domain of each workspace.
+pub const BRIDGE_DOMAIN_SUFFIX: &str = ".bridge.invalid";
+
+/// The reserved domain name of a workspace.
+#[must_use]
+pub fn bridge_domain_name(workspace_id: Id) -> String {
+    format!(
+        "{}{BRIDGE_DOMAIN_SUFFIX}",
+        workspace_id.to_string().replace('-', "")
+    )
+}
+
+/// One enrolled device.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+pub struct DeviceRecord {
+    /// Lowercase hyphenated UUID, as in the delivery URL.
+    pub device_id: String,
+    pub workspace_id: Id,
+    pub user_id: Id,
+    pub membership_id: Id,
+    pub mailbox_id: Id,
+    /// The primary address of the mailbox the device delivers to.
+    pub address_id: Id,
+    pub name: String,
+    /// SPKI DER, standard base64.
+    pub public_key: String,
+    pub created_at: i64,
+    /// Set when the device is revoked; a revoked device is refused at delivery.
+    pub revoked_at: Option<i64>,
+}
+
+#[derive(Debug, Error)]
+pub enum RegistryError {
+    #[error("bridge registry I/O failed: {0}")]
+    Io(#[from] std::io::Error),
+    #[error("bridge registry is not valid JSON: {0}")]
+    Format(#[from] serde_json::Error),
+}
+
+#[derive(Default, Serialize, Deserialize)]
+struct RegistryFile {
+    #[serde(default = "version")]
+    version: u32,
+    #[serde(default)]
+    devices: Vec<DeviceRecord>,
+}
+
+const fn version() -> u32 {
+    1
+}
+
+/// The registry file. Cheap to share (`Arc`); writes of one process are serialized.
+#[derive(Debug)]
+pub struct BridgeRegistry {
+    path: PathBuf,
+    writes: Mutex<()>,
+}
+
+impl BridgeRegistry {
+    #[must_use]
+    pub fn new(path: PathBuf) -> Self {
+        Self {
+            path,
+            writes: Mutex::new(()),
+        }
+    }
+
+    #[must_use]
+    pub fn path(&self) -> &Path {
+        &self.path
+    }
+
+    /// The device with this id (revoked ones too: the caller tells them apart).
+    pub async fn lookup(&self, device_id: &str) -> Result<Option<DeviceRecord>, RegistryError> {
+        let file = self.read().await?;
+        Ok(file
+            .devices
+            .into_iter()
+            .find(|device| device.device_id == device_id))
+    }
+
+    /// The devices a user enrolled in a workspace, oldest first.
+    pub async fn list_for_user(
+        &self,
+        workspace_id: Id,
+        user_id: Id,
+    ) -> Result<Vec<DeviceRecord>, RegistryError> {
+        let file = self.read().await?;
+        Ok(file
+            .devices
+            .into_iter()
+            .filter(|device| device.workspace_id == workspace_id && device.user_id == user_id)
+            .collect())
+    }
+
+    pub async fn add(&self, record: DeviceRecord) -> Result<(), RegistryError> {
+        let _guard = self.writes.lock().await;
+        let mut file = self.read().await?;
+        file.devices.push(record);
+        self.write(&file).await
+    }
+
+    /// Marks the device revoked at `now` (a device revoked before keeps its time). `None` when no
+    /// such device exists.
+    pub async fn revoke(
+        &self,
+        device_id: &str,
+        now: TimestampMillis,
+    ) -> Result<Option<DeviceRecord>, RegistryError> {
+        let _guard = self.writes.lock().await;
+        let mut file = self.read().await?;
+        let Some(device) = file
+            .devices
+            .iter_mut()
+            .find(|device| device.device_id == device_id)
+        else {
+            return Ok(None);
+        };
+        if device.revoked_at.is_none() {
+            device.revoked_at = Some(now.as_millis());
+            let revoked = device.clone();
+            self.write(&file).await?;
+            return Ok(Some(revoked));
+        }
+        Ok(Some(device.clone()))
+    }
+
+    async fn read(&self) -> Result<RegistryFile, RegistryError> {
+        match tokio::fs::read(&self.path).await {
+            Ok(bytes) => Ok(serde_json::from_slice(&bytes)?),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                Ok(RegistryFile::default())
+            }
+            Err(error) => Err(error.into()),
+        }
+    }
+
+    async fn write(&self, file: &RegistryFile) -> Result<(), RegistryError> {
+        let bytes = serde_json::to_vec_pretty(file)?;
+        let path = self.path.clone();
+        tokio::task::spawn_blocking(move || write_atomically(&path, &bytes))
+            .await
+            .map_err(|error| std::io::Error::other(error.to_string()))??;
+        Ok(())
+    }
+}
+
+/// Writes `bytes` to a temporary file next to `path`, syncs it and renames it over `path`.
+fn write_atomically(path: &Path, bytes: &[u8]) -> std::io::Result<()> {
+    let directory = path
+        .parent()
+        .filter(|directory| !directory.as_os_str().is_empty())
+        .unwrap_or_else(|| Path::new("."));
+    std::fs::create_dir_all(directory)?;
+    let mut suffix = [0_u8; 6];
+    rand_core::OsRng.fill_bytes(&mut suffix);
+    let temporary = directory.join(format!(
+        ".{}.{}.tmp",
+        path.file_name().map_or_else(
+            || "registry".to_owned(),
+            |name| name.to_string_lossy().into_owned()
+        ),
+        suffix
+            .iter()
+            .map(|byte| format!("{byte:02x}"))
+            .collect::<String>()
+    ));
+    let result = (|| {
+        let mut file = std::fs::File::create(&temporary)?;
+        file.write_all(bytes)?;
+        file.sync_all()?;
+        drop(file);
+        std::fs::rename(&temporary, path)
+    })();
+    if result.is_err() {
+        let _ = std::fs::remove_file(&temporary);
+    }
+    result
+}
+
+/// A public key in the registry format: SPKI DER of an uncompressed NIST P-256 point, base64.
+/// Returns the canonical base64, or `None` when the key is not one.
+#[must_use]
+pub fn normalize_public_key(value: &str) -> Option<String> {
+    use p256::pkcs8::DecodePublicKey as _;
+
+    let der = STANDARD.decode(value.trim()).ok()?;
+    // 26 bytes of header, then the 65 bytes of the uncompressed point (0x04, x, y)
+    if der.len() != 91 || der.get(26) != Some(&0x04) {
+        return None;
+    }
+    p256::PublicKey::from_public_key_der(&der).ok()?;
+    Some(STANDARD.encode(der))
+}
+
+/// Why a user cannot get a bridge mailbox.
+#[derive(Debug, Error)]
+pub enum BridgeMailboxError {
+    /// Not a member (or a guest) of the workspace.
+    #[error("not a member of the workspace")]
+    NotFound,
+    /// The user's personal mailbox is suspended, or an admin disabled the reserved domain.
+    #[error("the mailbox or the domain is not available")]
+    Unavailable,
+    #[error(transparent)]
+    Database(#[from] sqlx::Error),
+}
+
+/// Where a device's mail goes.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct BridgeMailbox {
+    pub membership_id: Id,
+    pub mailbox_id: Id,
+    pub address_id: Id,
+    /// `local@domain`.
+    pub address: String,
+}
+
+/// The personal mailbox of a member for the bridge: the one the member has, or a new one on the
+/// workspace's reserved `.invalid` domain (created, verified, when missing). Safe to call again.
+pub async fn ensure_bridge_mailbox(
+    database: &Database,
+    workspace_id: Id,
+    user_id: Id,
+) -> Result<BridgeMailbox, BridgeMailboxError> {
+    let now = database.database_now().await?.as_millis();
+    let mut transaction = database.immediate_transaction().await?;
+    membership::actor(&mut *transaction, workspace_id, user_id)
+        .await?
+        .ok_or(BridgeMailboxError::NotFound)?;
+    let row = sqlx::query(
+        "SELECT ms.id AS membership_id, u.display_name FROM memberships ms \
+         JOIN users u ON u.id = ms.user_id WHERE ms.workspace_id = $1 AND ms.user_id = $2",
+    )
+    .bind(workspace_id.to_string())
+    .bind(user_id.to_string())
+    .fetch_optional(&mut *transaction)
+    .await?
+    .ok_or(BridgeMailboxError::NotFound)?;
+    let membership_text: String = row.try_get("membership_id")?;
+    let display_name: String = row.try_get("display_name")?;
+    let membership_id = parse(&membership_text)?;
+
+    let existing = sqlx::query(
+        "SELECT m.id AS mailbox_id, m.status, a.id AS address_id, a.local_part, d.name \
+         FROM mailboxes m \
+         JOIN mail_addresses a ON a.mailbox_id = m.id AND a.kind = 'primary' \
+         JOIN mail_domains d ON d.id = a.domain_id \
+         WHERE m.owner_membership_id = $1",
+    )
+    .bind(&membership_text)
+    .fetch_optional(&mut *transaction)
+    .await?;
+    if let Some(row) = existing {
+        let status: String = row.try_get("status")?;
+        if status != "active" {
+            return Err(BridgeMailboxError::Unavailable);
+        }
+        let local: String = row.try_get("local_part")?;
+        let domain: String = row.try_get("name")?;
+        let found = BridgeMailbox {
+            membership_id,
+            mailbox_id: parse(&row.try_get::<String, _>("mailbox_id")?)?,
+            address_id: parse(&row.try_get::<String, _>("address_id")?)?,
+            address: format!("{local}@{domain}"),
+        };
+        transaction.commit().await?;
+        return Ok(found);
+    }
+
+    let name = bridge_domain_name(workspace_id);
+    let domain =
+        sqlx::query("SELECT id, status FROM mail_domains WHERE workspace_id = $1 AND name = $2")
+            .bind(workspace_id.to_string())
+            .bind(&name)
+            .fetch_optional(&mut *transaction)
+            .await?;
+    let domain_id =
+        if let Some(row) = domain {
+            let status: String = row.try_get("status")?;
+            if status != "verified" {
+                return Err(BridgeMailboxError::Unavailable);
+            }
+            parse(&row.try_get::<String, _>("id")?)?
+        } else {
+            let id = Id::new_v7();
+            let mut token = [0_u8; 16];
+            rand_core::OsRng.fill_bytes(&mut token);
+            sqlx::query(
+            "INSERT INTO mail_domains (id, workspace_id, name, status, verify_token, verified_at, \
+             created_at, updated_at) VALUES ($1, $2, $3, 'verified', $4, $5, $5, $5)",
+        )
+        .bind(id.to_string())
+        .bind(workspace_id.to_string())
+        .bind(&name)
+        .bind(token.iter().map(|byte| format!("{byte:02x}")).collect::<String>())
+        .bind(now)
+        .execute(&mut *transaction)
+        .await?;
+            id
+        };
+
+    let mailbox_id = Id::new_v7();
+    let address_id = Id::new_v7();
+    let local = membership_text.replace('-', "");
+    let mailbox_name: String = display_name.chars().take(120).collect();
+    sqlx::query(
+        "INSERT INTO mailboxes (id, workspace_id, kind, name, owner_membership_id, status, \
+         created_at, updated_at) VALUES ($1, $2, 'personal', $3, $4, 'active', $5, $5)",
+    )
+    .bind(mailbox_id.to_string())
+    .bind(workspace_id.to_string())
+    .bind(if mailbox_name.is_empty() {
+        "Worbit"
+    } else {
+        &mailbox_name
+    })
+    .bind(&membership_text)
+    .bind(now)
+    .execute(&mut *transaction)
+    .await?;
+    sqlx::query(
+        "INSERT INTO mailbox_members (mailbox_id, membership_id, created_at) VALUES ($1, $2, $3)",
+    )
+    .bind(mailbox_id.to_string())
+    .bind(&membership_text)
+    .bind(now)
+    .execute(&mut *transaction)
+    .await?;
+    sqlx::query(
+        "INSERT INTO mail_addresses (id, domain_id, mailbox_id, local_part, kind, created_at) \
+         VALUES ($1, $2, $3, $4, 'primary', $5)",
+    )
+    .bind(address_id.to_string())
+    .bind(domain_id.to_string())
+    .bind(mailbox_id.to_string())
+    .bind(&local)
+    .bind(now)
+    .execute(&mut *transaction)
+    .await?;
+    transaction.commit().await?;
+    Ok(BridgeMailbox {
+        membership_id,
+        mailbox_id,
+        address_id,
+        address: format!("{local}@{name}"),
+    })
+}
+
+fn parse(value: &str) -> Result<Id, sqlx::Error> {
+    value
+        .parse()
+        .map_err(|error| sqlx::Error::Decode(Box::new(error)))
+}
