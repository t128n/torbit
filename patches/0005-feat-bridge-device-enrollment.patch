diff --git a/apps/server/tests/mail_bridge.rs b/apps/server/tests/mail_bridge.rs
new file mode 100644
index 00000000..b5648f9e
--- /dev/null
+++ b/apps/server/tests/mail_bridge.rs
@@ -0,0 +1,598 @@
+//! Worbit bridge device enrollment: the registry file, the enrollment, list and revoke API, the
+//! per-workspace `.invalid` domain with the user's personal mailbox, and the DNS check that
+//! leaves that domain alone.
+
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use axum::body::{Body, to_bytes};
+use axum::http::{Request, StatusCode, header};
+use orbit_platform::{
+    AttachmentMutationCoordinator, AuthenticatedUser, Id, LocalBlobStore, MailMode, TestDatabase,
+    TimestampMillis, UploadLimits, UploadService,
+};
+use orbit_server::auth_routes::CookieMode;
+use orbit_server::mail_bridge::BridgeRegistry;
+use orbit_server::mail_dns::{DnsChecker, FakeDns};
+use orbit_server::mail_routes::{MailSettings, MailState, mail_router};
+use orbit_server::repositories::identity::{IdentityRepository, SetupRequest};
+use orbit_server::repositories::instance_settings::InstanceSettingsRepository;
+use orbit_server::repositories::mail::{DomainStatus, MailRepository};
+use serde_json::{Value, json};
+use tower::ServiceExt;
+
+const APP_KEY: [u8; 32] = [7; 32];
+/// The throwaway P-256 key of `tests/bridge-vectors.json` (SPKI DER, base64).
+const PUBLIC_KEY: &str = "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEVWdz1M4dMUeIDjHe5q2Bldyuj+17hs/6Uzy0Yh472OokRcmePszhH703VTFrmEhLqMst+TROwubj/+ZKLmwl1Q==";
+
+struct Member {
+    id: Id,
+    membership_id: Id,
+    cookie: String,
+}
+
+struct Fixture {
+    _root: tempfile::TempDir,
+    registry_path: PathBuf,
+    database: TestDatabase,
+    identity: Arc<IdentityRepository>,
+    mail: Arc<MailRepository>,
+    registry: Arc<BridgeRegistry>,
+    app: axum::Router,
+    workspace: Id,
+    owner: Member,
+}
+
+impl Fixture {
+    async fn new() -> Self {
+        Self::with(true, true).await
+    }
+
+    /// `registry`: the registry path is configured; `mail`: the instance mail switch is on.
+    async fn with(registry: bool, mail: bool) -> Self {
+        let database = TestDatabase::new().await.unwrap();
+        let identity = Arc::new(IdentityRepository::new((*database).clone()));
+        let now = TimestampMillis::now();
+        identity
+            .store_setup_token(
+                "operator-secret",
+                TimestampMillis::from_millis(now.as_millis() + 60_000),
+            )
+            .await
+            .unwrap();
+        let setup = identity
+            .complete_setup(
+                SetupRequest {
+                    token: "operator-secret".to_owned(),
+                    email: "owner@example.com".to_owned(),
+                    display_name: "Owner".to_owned(),
+                    password_hash: "unused".to_owned(),
+                    workspace_name: "Orbit".to_owned(),
+                    project_name: "General".to_owned(),
+                },
+                now,
+            )
+            .await
+            .unwrap();
+        InstanceSettingsRepository::new((*database).clone())
+            .set_mail_enabled(setup.user_id, mail, "request", now)
+            .await
+            .unwrap();
+        let root = tempfile::tempdir().unwrap();
+        let uploads = UploadService::new(
+            (*database).clone(),
+            Arc::new(LocalBlobStore::new(root.path().join("attachments"))),
+            AttachmentMutationCoordinator::default(),
+            UploadLimits::default(),
+        );
+        let mail_repo = Arc::new(MailRepository::new((*database).clone(), uploads, APP_KEY));
+        // A directory that does not exist yet: the registry creates it with the first device.
+        let registry_path = root.path().join("bridge").join("devices.json");
+        let bridge = Arc::new(BridgeRegistry::new(registry_path.clone()));
+        let mut state = MailState::new(
+            Arc::clone(&identity),
+            Arc::clone(&mail_repo),
+            CookieMode::secure(),
+            MailSettings {
+                enabled: false,
+                hostname: None,
+                mode: MailMode::Relay,
+            },
+        );
+        if registry {
+            state = state.with_bridge(Arc::clone(&bridge));
+        }
+        let membership: String = sqlx::query_scalar(
+            "SELECT id FROM memberships WHERE workspace_id = $1 AND user_id = $2",
+        )
+        .bind(setup.workspace_id.to_string())
+        .bind(setup.user_id.to_string())
+        .fetch_one(database.pool())
+        .await
+        .unwrap();
+        Self {
+            _root: root,
+            registry_path,
+            database,
+            identity,
+            mail: mail_repo,
+            registry: bridge,
+            app: mail_router(state),
+            workspace: setup.workspace_id,
+            owner: Member {
+                id: setup.user_id,
+                membership_id: membership.parse().unwrap(),
+                cookie: format!("__Host-orbit_session={}", setup.session.token),
+            },
+        }
+    }
+
+    async fn user(&self, role: &str) -> Member {
+        let id = Id::new_v7();
+        let now = TimestampMillis::now();
+        let email = format!("{id}@example.com");
+        sqlx::query(
+            "INSERT INTO users (id, email, normalized_email, display_name, password_hash, created_at, updated_at) \
+             VALUES ($1, $2, $3, 'Member', 'unused', $4, $4)",
+        )
+        .bind(id.to_string())
+        .bind(&email)
+        .bind(&email)
+        .bind(now.as_millis())
+        .execute(self.database.pool())
+        .await
+        .unwrap();
+        let membership_id = Id::new_v7();
+        sqlx::query(
+            "INSERT INTO memberships (id, workspace_id, user_id, role, version, created_at, updated_at) \
+             VALUES ($1, $2, $3, $4, 0, $5, $5)",
+        )
+        .bind(membership_id.to_string())
+        .bind(self.workspace.to_string())
+        .bind(id.to_string())
+        .bind(role)
+        .bind(now.as_millis())
+        .execute(self.database.pool())
+        .await
+        .unwrap();
+        let session = self
+            .identity
+            .create_session(
+                &AuthenticatedUser {
+                    id,
+                    email,
+                    display_name: "Member".to_owned(),
+                },
+                now,
+            )
+            .await
+            .unwrap();
+        Member {
+            id,
+            membership_id,
+            cookie: format!("__Host-orbit_session={}", session.token),
+        }
+    }
+
+    async fn call(
+        &self,
+        cookie: Option<&str>,
+        method: &str,
+        path: &str,
+        body: Option<Value>,
+    ) -> (StatusCode, Value) {
+        let mut builder = Request::builder().method(method).uri(format!(
+            "/api/v1/workspaces/{}/mail/bridge/devices{path}",
+            self.workspace
+        ));
+        if let Some(cookie) = cookie {
+            builder = builder.header(header::COOKIE, cookie);
+        }
+        let request = match body {
+            Some(value) => builder
+                .header(header::CONTENT_TYPE, "application/json")
+                .body(Body::from(value.to_string())),
+            None => builder.body(Body::empty()),
+        }
+        .unwrap();
+        let response = self.app.clone().oneshot(request).await.unwrap();
+        let status = response.status();
+        let bytes = to_bytes(response.into_body(), usize::MAX).await.unwrap();
+        let value = if bytes.is_empty() {
+            Value::Null
+        } else {
+            serde_json::from_slice(&bytes).unwrap_or(Value::Null)
+        };
+        (status, value)
+    }
+
+    async fn enroll(&self, member: &Member, name: &str) -> (StatusCode, Value) {
+        self.call(
+            Some(&member.cookie),
+            "POST",
+            "",
+            Some(json!({ "name": name, "public_key": PUBLIC_KEY })),
+        )
+        .await
+    }
+
+    async fn count(&self, sql: &str) -> i64 {
+        sqlx::query_scalar(sqlx::AssertSqlSafe(sql.to_owned()))
+            .fetch_one(self.database.pool())
+            .await
+            .unwrap()
+    }
+}
+
+#[tokio::test]
+async fn enrollment_registers_the_device_and_creates_domain_and_mailbox() {
+    let fixture = Fixture::new().await;
+    let (status, device) = fixture.enroll(&fixture.owner, "Work laptop").await;
+    assert_eq!(status, StatusCode::CREATED, "{device}");
+
+    let device_id = device["id"].as_str().unwrap();
+    assert_eq!(device_id.len(), 36);
+    assert_eq!(device_id, device_id.to_lowercase());
+    assert_eq!(device["name"], "Work laptop");
+    assert_eq!(device["revoked_at"], Value::Null);
+    let domain = format!(
+        "{}.bridge.invalid",
+        fixture.workspace.to_string().replace('-', "")
+    );
+    assert!(
+        device["address"]
+            .as_str()
+            .unwrap()
+            .ends_with(&format!("@{domain}")),
+        "{device}"
+    );
+
+    // the domain is verified, without a provider, and the mailbox is the owner's personal one
+    let verified = fixture
+        .count(&format!(
+            "SELECT COUNT(*) FROM mail_domains WHERE name = '{domain}' AND status = 'verified' \
+             AND provider_id IS NULL AND workspace_id = '{}'",
+            fixture.workspace
+        ))
+        .await;
+    assert_eq!(verified, 1);
+    let personal = fixture
+        .count(&format!(
+            "SELECT COUNT(*) FROM mailboxes WHERE kind = 'personal' AND status = 'active' \
+             AND owner_membership_id = '{}'",
+            fixture.owner.membership_id
+        ))
+        .await;
+    assert_eq!(personal, 1);
+
+    // the registry file holds the key and the destination, for the delivery endpoint
+    let record = fixture.registry.lookup(device_id).await.unwrap().unwrap();
+    assert_eq!(record.public_key, PUBLIC_KEY);
+    assert_eq!(record.workspace_id, fixture.workspace);
+    assert_eq!(record.user_id, fixture.owner.id);
+    assert_eq!(record.revoked_at, None);
+    let mailbox_address: String = sqlx::query_scalar(
+        "SELECT a.id FROM mail_addresses a JOIN mailboxes m ON m.id = a.mailbox_id \
+         WHERE m.owner_membership_id = $1 AND a.kind = 'primary'",
+    )
+    .bind(fixture.owner.membership_id.to_string())
+    .fetch_one(fixture.database.pool())
+    .await
+    .unwrap();
+    assert_eq!(record.address_id.to_string(), mailbox_address);
+    assert!(
+        fixture
+            .registry
+            .lookup("not-a-device")
+            .await
+            .unwrap()
+            .is_none()
+    );
+}
+
+#[tokio::test]
+async fn a_second_device_reuses_the_domain_and_the_mailbox() {
+    let fixture = Fixture::new().await;
+    let member = fixture.user("member").await;
+    let (_, first) = fixture.enroll(&member, "Laptop").await;
+    let (status, second) = fixture.enroll(&member, "Desktop").await;
+    assert_eq!(status, StatusCode::CREATED);
+    assert_ne!(first["id"], second["id"]);
+    assert_eq!(first["address"], second["address"]);
+    assert_eq!(
+        fixture
+            .count("SELECT COUNT(*) FROM mail_domains WHERE name LIKE '%.bridge.invalid'")
+            .await,
+        1
+    );
+    assert_eq!(
+        fixture
+            .count("SELECT COUNT(*) FROM mailboxes WHERE kind = 'personal' AND owner_membership_id IS NOT NULL")
+            .await,
+        1
+    );
+    // a second member gets a mailbox of their own on the same domain
+    let other = fixture.user("member").await;
+    let (status, third) = fixture.enroll(&other, "Laptop").await;
+    assert_eq!(status, StatusCode::CREATED);
+    assert_ne!(first["address"], third["address"]);
+    assert_eq!(
+        fixture
+            .count("SELECT COUNT(*) FROM mail_domains WHERE name LIKE '%.bridge.invalid'")
+            .await,
+        1
+    );
+}
+
+#[tokio::test]
+async fn a_member_with_a_personal_mailbox_keeps_it() {
