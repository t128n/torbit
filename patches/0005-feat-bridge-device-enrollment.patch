@@ -0,0 +1,256 @@
+//! Worbit bridge devices: enroll, list and revoke. Session-authenticated. The routes answer 404
+//! while the registry path is not configured or mail is off on the instance. A member sees and
+//! revokes their own devices; a workspace owner or admin can revoke any device of the workspace.
+
+use std::sync::Arc;
+
+use axum::Json;
+use axum::extract::{Path, State};
+use axum::http::{HeaderMap, StatusCode, Uri};
+use orbit_domain::Permission;
+use orbit_platform::{Id, TimestampMillis};
+use serde::{Deserialize, Serialize};
+use utoipa::ToSchema;
+
+use super::{MailState, RequestIdExtension, problem};
+use crate::mail_bridge::{
+    BridgeMailboxError, BridgeRegistry, DeviceRecord, ensure_bridge_mailbox, normalize_public_key,
+};
+use crate::repositories::instance_settings::InstanceSettingsRepository;
+use crate::repositories::mail::MailError;
+use crate::repositories::membership;
+use crate::task_routes::{ApiError, ApiJson, authenticate_session};
+
+/// An enrolled device. The public key stays in the registry.
+#[derive(Serialize, ToSchema)]
+pub(crate) struct BridgeDevice {
+    /// The id in the delivery URL.
+    id: String,
+    name: String,
+    /// The mailbox address the device delivers to.
+    address: String,
+    #[schema(value_type = String)]
+    mailbox_id: Id,
+    #[schema(value_type = String, format = DateTime)]
+    created_at: TimestampMillis,
+    /// Set once the device is revoked.
+    #[schema(value_type = Option<String>, format = DateTime)]
+    revoked_at: Option<TimestampMillis>,
+}
+
+#[derive(Deserialize, ToSchema)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct EnrollBridgeDeviceBody {
+    /// A name for the device (1 to 80 characters).
+    name: String,
+    /// The device's P-256 public key: SubjectPublicKeyInfo DER, base64.
+    public_key: String,
+}
+
+struct Call<'a> {
+    registry: Arc<BridgeRegistry>,
+    workspace_id: Id,
+    user_id: Id,
+    instance: String,
+    request_id: Option<&'a axum::extract::Extension<orbit_platform::RequestId>>,
+}
+
+impl<'a> Call<'a> {
+    async fn enter(
+        state: &MailState,
+        headers: &HeaderMap,
+        uri: &Uri,
+        workspace: &str,
+        request_id: &'a RequestIdExtension,
+    ) -> Result<Self, ApiError> {
+        let instance = uri.path().to_owned();
+        let request_id = request_id.as_ref();
+        let not_found = || problem(MailError::NotFound, &instance, request_id);
+        // off: no registry path, or mail is off on the instance
+        let registry = state.bridge.clone().ok_or_else(not_found)?;
+        let enabled = InstanceSettingsRepository::new(state.identity.database().clone())
+            .mail_enabled()
+            .await
+            .map_err(|error| problem(MailError::Unavailable(error), &instance, request_id))?;
+        if !enabled {
+            return Err(not_found());
+        }
+        let session = authenticate_session(
+            &state.identity,
+            state.cookie_mode,
+            headers,
+            &instance,
+            request_id,
+        )
+        .await?;
+        let workspace_id = workspace.parse().map_err(|_| not_found())?;
+        Ok(Self {
+            registry,
+            workspace_id,
+            user_id: session.user.id,
+            instance,
+            request_id,
+        })
+    }
+
+    fn problem(&self, error: MailError) -> ApiError {
+        problem(error, &self.instance, self.request_id)
+    }
+
+    fn registry_error(&self, error: &crate::mail_bridge::RegistryError) -> ApiError {
+        tracing::error!(error = %error, "bridge registry");
+        ApiError::new(
+            StatusCode::INTERNAL_SERVER_ERROR,
+            "internal_error",
+            "Internal server error",
+            "An unexpected error occurred. Use the request ID when contacting support.",
+            &self.instance,
+            self.request_id,
+        )
+        .cause(error.to_string())
+    }
+
+    async fn device(
+        &self,
+        state: &MailState,
+        record: DeviceRecord,
+    ) -> Result<BridgeDevice, ApiError> {
+        let address: Option<String> = sqlx::query_scalar(
+            "SELECT a.local_part || '@' || d.name FROM mail_addresses a \
+             JOIN mail_domains d ON d.id = a.domain_id WHERE a.id = $1",
+        )
+        .bind(record.address_id.to_string())
+        .fetch_optional(state.mail.database().pool())
+        .await
+        .map_err(|error| self.problem(MailError::Unavailable(error)))?;
+        Ok(BridgeDevice {
+            id: record.device_id,
+            name: record.name,
+            address: address.unwrap_or_default(),
+            mailbox_id: record.mailbox_id,
+            created_at: TimestampMillis::from_millis(record.created_at),
+            revoked_at: record.revoked_at.map(TimestampMillis::from_millis),
+        })
+    }
+}
+
+/// Enrolls a device of the caller: registers its public key and gives it the caller's personal
+/// mailbox (created on the workspace's reserved `.invalid` domain when the caller has none).
+#[utoipa::path(post, path = "/api/v1/workspaces/{workspace_id}/mail/bridge/devices", params(("workspace_id" = String, Path)), request_body = EnrollBridgeDeviceBody, responses((status = 201, body = BridgeDevice)))]
+pub(crate) async fn enroll_bridge_device(
+    State(state): State<MailState>,
+    Path(workspace): Path<String>,
+    headers: HeaderMap,
+    uri: Uri,
+    request_id: RequestIdExtension,
+    ApiJson(body): ApiJson<EnrollBridgeDeviceBody>,
+) -> Result<(StatusCode, Json<BridgeDevice>), ApiError> {
+    let call = Call::enter(&state, &headers, &uri, &workspace, &request_id).await?;
+    let name = body.name.trim();
+    if name.is_empty() || name.chars().count() > 80 {
+        return Err(call.problem(MailError::Invalid { field: "name" }));
+    }
+    let public_key = normalize_public_key(&body.public_key).ok_or_else(|| {
+        call.problem(MailError::Invalid {
+            field: "public_key",
+        })
+    })?;
+    let mailbox = ensure_bridge_mailbox(state.mail.database(), call.workspace_id, call.user_id)
+        .await
+        .map_err(|error| match error {
+            BridgeMailboxError::NotFound => call.problem(MailError::NotFound),
+            BridgeMailboxError::Unavailable => {
+                call.problem(MailError::Conflict("bridge_mailbox_unavailable"))
+            }
+            BridgeMailboxError::Database(error) => call.problem(MailError::Unavailable(error)),
+        })?;
+    let now = state
+        .mail
+        .database()
+        .database_now()
+        .await
+        .map_err(|error| call.problem(MailError::Unavailable(error)))?;
+    let record = DeviceRecord {
+        device_id: Id::new_v7().to_string(),
+        workspace_id: call.workspace_id,
+        user_id: call.user_id,
+        membership_id: mailbox.membership_id,
+        mailbox_id: mailbox.mailbox_id,
+        address_id: mailbox.address_id,
+        name: name.to_owned(),
+        public_key,
+        created_at: now.as_millis(),
+        revoked_at: None,
+    };
+    call.registry
+        .add(record.clone())
+        .await
+        .map_err(|error| call.registry_error(&error))?;
+    let device = call.device(&state, record).await?;
+    Ok((StatusCode::CREATED, Json(device)))
+}
+
+/// The caller's own devices in this workspace, revoked ones included.
+#[utoipa::path(get, path = "/api/v1/workspaces/{workspace_id}/mail/bridge/devices", params(("workspace_id" = String, Path)), responses((status = 200, body = Vec<BridgeDevice>)))]
+pub(crate) async fn list_bridge_devices(
+    State(state): State<MailState>,
+    Path(workspace): Path<String>,
+    headers: HeaderMap,
+    uri: Uri,
+    request_id: RequestIdExtension,
+) -> Result<Json<Vec<BridgeDevice>>, ApiError> {
+    let call = Call::enter(&state, &headers, &uri, &workspace, &request_id).await?;
+    let records = call
+        .registry
+        .list_for_user(call.workspace_id, call.user_id)
+        .await
+        .map_err(|error| call.registry_error(&error))?;
+    let mut devices = Vec::with_capacity(records.len());
+    for record in records {
+        devices.push(call.device(&state, record).await?);
+    }
+    Ok(Json(devices))
+}
+
+/// Revokes a device: the delivery endpoint refuses it from now on. The device's owner and workspace
+/// owners and admins can revoke it; for anyone else the device does not exist. Revoking a revoked
+/// device succeeds.
+#[utoipa::path(delete, path = "/api/v1/workspaces/{workspace_id}/mail/bridge/devices/{device_id}", params(("workspace_id" = String, Path), ("device_id" = String, Path)), responses((status = 204)))]
+pub(crate) async fn revoke_bridge_device(
+    State(state): State<MailState>,
+    Path((workspace, device_id)): Path<(String, String)>,
+    headers: HeaderMap,
+    uri: Uri,
+    request_id: RequestIdExtension,
+) -> Result<StatusCode, ApiError> {
+    let call = Call::enter(&state, &headers, &uri, &workspace, &request_id).await?;
+    let device = call
+        .registry
+        .lookup(&device_id)
+        .await
+        .map_err(|error| call.registry_error(&error))?
+        .filter(|device| device.workspace_id == call.workspace_id)
+        .ok_or_else(|| call.problem(MailError::NotFound))?;
+    let actor = membership::actor(
+        state.mail.database().pool(),
+        call.workspace_id,
+        call.user_id,
+    )
+    .await
+    .map_err(|error| call.problem(MailError::Unavailable(error)))?
+    .ok_or_else(|| call.problem(MailError::NotFound))?;
+    if device.user_id != call.user_id && !actor.can(Permission::MailManage) {
+        return Err(call.problem(MailError::NotFound));
+    }
+    let now = state
+        .mail
+        .database()
+        .database_now()
+        .await
+        .map_err(|error| call.problem(MailError::Unavailable(error)))?;
+    call.registry
+        .revoke(&device.device_id, now)
+        .await
+        .map_err(|error| call.registry_error(&error))?;
+    Ok(StatusCode::NO_CONTENT)
+}
