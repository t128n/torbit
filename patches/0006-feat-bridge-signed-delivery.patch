+
+// Signed delivery (`docs/bridge-signing.md` of the Worbit repository, format `worbit-bridge-v1`).
+
+/// The first line of the signed string.
+pub const SIGNING_FORMAT: &str = "worbit-bridge-v1";
+/// A timestamp is accepted when it is at most this many seconds from the server's clock.
+pub const WINDOW_SECS: i64 = 300;
+/// A `(device, nonce)` pair is remembered this long (twice the window).
+pub const NONCE_MEMORY_SECS: i64 = 600;
+/// The largest message a bridge delivery may carry. It is the platform's cap on non-multipart
+/// bodies, so the handler and the platform layer agree.
+pub const MAX_MESSAGE_BYTES: usize = 2 * 1024 * 1024;
+/// Request bodies read at once.
+const BODIES_AT_ONCE: usize = 4;
+
+/// Why a delivery was refused. Logged by the handler; the response never tells which.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Refusal {
+    Malformed,
+    BadSignature,
+    Expired,
+    Replay,
+}
+
+/// The values of the three request headers, as sent.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct SignedHeaders {
+    pub timestamp: i64,
+    /// The header text (it is part of the signed string).
+    pub timestamp_text: String,
+    pub nonce: String,
+    pub signature: [u8; 64],
+}
+
+impl SignedHeaders {
+    /// Parses the header values: digits only without leading zeros, a nonce of 8 to 64 characters
+    /// from `A-Za-z0-9-_`, and a standard base64 signature of 64 bytes.
+    pub fn parse(timestamp: &str, nonce: &str, signature: &str) -> Result<Self, Refusal> {
+        let digits = !timestamp.is_empty()
+            && timestamp.len() <= 12
+            && timestamp.bytes().all(|byte| byte.is_ascii_digit())
+            && !timestamp.starts_with('0');
+        let nonce_ok = (8..=64).contains(&nonce.len())
+            && nonce
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || byte == b'-' || byte == b'_');
+        if !digits || !nonce_ok {
+            return Err(Refusal::Malformed);
+        }
+        let bytes = STANDARD.decode(signature).map_err(|_| Refusal::Malformed)?;
+        let signature: [u8; 64] = bytes.try_into().map_err(|_| Refusal::Malformed)?;
+        Ok(Self {
+            timestamp: timestamp.parse().map_err(|_| Refusal::Malformed)?,
+            timestamp_text: timestamp.to_owned(),
+            nonce: nonce.to_owned(),
+            signature,
+        })
+    }
+}
+
+/// The string a device signs: five lines joined by LF.
+#[must_use]
+pub fn signed_string(timestamp: &str, nonce: &str, device_id: &str, body: &[u8]) -> String {
+    use sha2::{Digest as _, Sha256};
+    format!(
+        "{SIGNING_FORMAT}\n{timestamp}\n{nonce}\n{device_id}\n{:x}",
+        Sha256::digest(body)
+    )
+}
+
+/// Whether `signature` (IEEE P1363, `r || s`) is the device key's ECDSA signature over `signed`.
+#[must_use]
+pub fn signature_valid(public_key: &str, signed: &str, signature: &[u8; 64]) -> bool {
+    use p256::ecdsa::signature::Verifier as _;
+    use p256::ecdsa::{Signature, VerifyingKey};
+    use p256::pkcs8::DecodePublicKey as _;
+
+    let Ok(der) = STANDARD.decode(public_key) else {
+        return false;
+    };
+    let Ok(key) = VerifyingKey::from_public_key_der(&der) else {
+        return false;
+    };
+    let Ok(signature) = Signature::from_slice(signature) else {
+        return false;
+    };
+    key.verify(signed.as_bytes(), &signature).is_ok()
+}
+
+/// What a bridge delivery needs besides the registry: its own intake (never the providers'), the
+/// nonce memory and the clock.
+pub struct BridgeDelivery {
+    intake: crate::mail_intake::MailIntake,
+    nonces: std::sync::Mutex<std::collections::HashMap<(String, String), i64>>,
+    bodies: tokio::sync::Semaphore,
+    /// Tests only: a fixed clock, unix seconds.
+    fixed_now: Option<i64>,
+}
+
+impl BridgeDelivery {
+    #[must_use]
+    pub fn new(mail: std::sync::Arc<crate::repositories::mail::MailRepository>) -> Self {
+        Self {
+            intake: crate::mail_intake::MailIntake::new(
+                mail,
+                MAX_MESSAGE_BYTES as u64 + crate::mail_listener::TRACE_HEADROOM,
+            ),
+            nonces: std::sync::Mutex::new(std::collections::HashMap::new()),
+            bodies: tokio::sync::Semaphore::new(BODIES_AT_ONCE),
+            fixed_now: None,
+        }
+    }
+
+    /// Tests only: the server's clock reads `now` (unix seconds).
+    #[doc(hidden)]
+    #[must_use]
+    pub fn with_fixed_now(mut self, now: i64) -> Self {
+        self.fixed_now = Some(now);
+        self
+    }
+
+    #[must_use]
+    pub fn now_secs(&self) -> i64 {
+        self.fixed_now
+            .unwrap_or_else(|| TimestampMillis::now().as_millis() / 1000)
+    }
+
+    pub async fn body_permit(&self) -> Option<tokio::sync::SemaphorePermit<'_>> {
+        self.bodies.acquire().await.ok()
+    }
+
+    #[must_use]
+    pub const fn intake(&self) -> &crate::mail_intake::MailIntake {
+        &self.intake
+    }
+
+    /// Remembers `(device, nonce)`; `false` when it was seen in the last [`NONCE_MEMORY_SECS`].
+    pub fn remember_nonce(&self, device_id: &str, nonce: &str, now: i64) -> bool {
+        let mut nonces = self
+            .nonces
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        nonces.retain(|_, seen| now - *seen <= NONCE_MEMORY_SECS);
+        match nonces.entry((device_id.to_owned(), nonce.to_owned())) {
+            std::collections::hash_map::Entry::Occupied(_) => false,
+            std::collections::hash_map::Entry::Vacant(slot) => {
+                slot.insert(now);
+                true
+            }
+        }
+    }
+
+    /// Forgets a nonce whose message was not stored, so the bridge can send it again.
+    pub fn forget_nonce(&self, device_id: &str, nonce: &str) {
+        self.nonces
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .remove(&(device_id.to_owned(), nonce.to_owned()));
+    }
+}
