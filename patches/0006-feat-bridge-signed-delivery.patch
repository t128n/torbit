index 07df6432..931bb507 100644
--- a/apps/server/src/mail_bridge.rs
+++ b/apps/server/src/mail_bridge.rs
@@ -379,3 +379,163 @@ fn parse(value: &str) -> Result<Id, sqlx::Error> {
         .parse()
