+/// Delivers one message from an enrolled device (`docs/bridge-signing.md`, format
+/// `worbit-bridge-v1`). The body is the raw MIME message. Checks, in order: the bridge is on and
+/// the device exists (404), it is not revoked (401), the headers, the signature, the timestamp
+/// window and the nonce (401), the size (413), then storage (503 to retry, 200 stored). The
+/// message always goes to the device's mailbox; recipients in the message are ignored. A 401 never
+/// says which check failed; the reason is logged, without message content.
+#[utoipa::path(
+    post,
+    path = "/api/v1/mail/inbound/bridge/{device_id}",
+    params(("device_id" = String, Path)),
+    request_body(content = String, content_type = "message/rfc822", description = "The raw message"),
+    responses((status = 200), (status = 401), (status = 404), (status = 413), (status = 503))
+)]
+pub(crate) async fn deliver_bridge_message(
+    State(state): State<MailState>,
+    Path(device_id): Path<String>,
+    headers: HeaderMap,
+    body: Body,
+) -> Response {
+    let (Some(registry), Some(delivery)) = (state.bridge.clone(), state.bridge_delivery.clone())
+    else {
+        return bridge_reply(StatusCode::NOT_FOUND, "not found");
+    };
+    match InstanceSettingsRepository::new(state.identity.database().clone())
+        .mail_enabled()
+        .await
+    {
+        Ok(true) => {}
+        Ok(false) => return bridge_reply(StatusCode::NOT_FOUND, "not found"),
+        Err(error) => {
+            tracing::warn!(%error, "bridge delivery: instance settings");
+            return bridge_reply(StatusCode::SERVICE_UNAVAILABLE, "try again later");
+        }
+    }
+    let device = match registry.lookup(&device_id).await {
+        Ok(Some(device)) => device,
+        Ok(None) => {
+            tracing::warn!(device = %device_id, "bridge delivery refused: unknown device");
+            return bridge_reply(StatusCode::NOT_FOUND, "not found");
+        }
+        Err(error) => {
+            tracing::error!(%error, "bridge delivery: registry");
+            return bridge_reply(StatusCode::SERVICE_UNAVAILABLE, "try again later");
+        }
+    };
+    if device.revoked_at.is_some() {
+        return refuse(&device_id, "revoked");
+    }
+    let signed = match signed_headers(&headers) {
+        Ok(signed) => signed,
+        Err(refusal) => return refuse(&device_id, reason(refusal)),
+    };
+
+    let Some(_permit) = delivery.body_permit().await else {
+        return bridge_reply(StatusCode::SERVICE_UNAVAILABLE, "try again later");
+    };
+    let Ok(raw) = axum::body::to_bytes(body, MAX_MESSAGE_BYTES).await else {
+        // the signature cannot be checked without the whole body
+        tracing::warn!(device = %device_id, "bridge delivery refused: body over the limit");
+        return bridge_reply(StatusCode::PAYLOAD_TOO_LARGE, "message too large");
+    };
+
+    let text = signed_string(&signed.timestamp_text, &signed.nonce, &device_id, &raw);
+    if !signature_valid(&device.public_key, &text, &signed.signature) {
+        return refuse(&device_id, reason(Refusal::BadSignature));
+    }
+    let now = delivery.now_secs();
+    if (now - signed.timestamp).abs() > WINDOW_SECS {
+        return refuse(&device_id, reason(Refusal::Expired));
+    }
+    if !delivery.remember_nonce(&device_id, &signed.nonce, now) {
+        return refuse(&device_id, reason(Refusal::Replay));
+    }
+
+    let received = chrono::Utc::now().to_rfc2822();
+    // The only header Orbit adds: where the message came from. No `Authentication-Results`: no
+    // check of the sender ran, and the device's signature says nothing about the message's From.
+    let trace = format!(
+        "Received: from worbit-bridge (device {device_id}) by Orbit with HTTPS;\r\n\t{received}\r\n"
+    );
+    let mut message = Vec::with_capacity(trace.len() + raw.len());
+    message.extend_from_slice(trace.as_bytes());
+    message.extend_from_slice(&raw);
+    let accepted = delivery
+        .intake()
+        .accept(InboundMessage {
+            source: Source::Bridge,
+            raw: message,
+            trace_len: trace.len(),
+            mail_from: None,
+            recipients: vec![Recipient::Mailbox {
+                workspace_id: device.workspace_id,
+                address_id: device.address_id,
+                rcpt: format!("bridge:{device_id}"),
+            }],
+            peer_ip: IpAddr::V4(Ipv4Addr::UNSPECIFIED),
+            helo: format!("bridge:{device_id}"),
+            tls: None,
+            auth: neutral(),
+        })
+        .await;
+    match accepted {
+        Ok(_) => bridge_reply(StatusCode::OK, "stored"),
+        Err(IntakeError::TooLarge) => {
+            bridge_reply(StatusCode::PAYLOAD_TOO_LARGE, "message too large")
+        }
+        Err(error) => {
+            // not stored: the bridge may send it again with the same nonce
+            delivery.forget_nonce(&device_id, &signed.nonce);
+            tracing::warn!(device = %device_id, %error, "bridge delivery not stored");
+            bridge_reply(StatusCode::SERVICE_UNAVAILABLE, "try again later")
+        }
+    }
+}
+
+/// The three headers, each exactly once.
+fn signed_headers(headers: &HeaderMap) -> Result<SignedHeaders, Refusal> {
+    let one = |name: &str| -> Result<&str, Refusal> {
+        let mut values = headers.get_all(name).iter();
+        match (values.next(), values.next()) {
+            (Some(value), None) => value.to_str().map_err(|_| Refusal::Malformed),
+            _ => Err(Refusal::Malformed),
+        }
+    };
+    SignedHeaders::parse(
+        one("x-worbit-timestamp")?,
+        one("x-worbit-nonce")?,
+        one("x-worbit-signature")?,
+    )
+}
+
+/// No check of the sender ran: not a pass, and not a DMARC failure that would file it as spam.
+fn neutral() -> AuthOutcome {
+    AuthOutcome {
+        spf: Verdict::None,
+        dkim: Verdict::None,
+        dmarc: DmarcVerdict::None,
+        aligned_domain: None,
+        temp_error: false,
+        spf_domain: None,
+        dkim_domain: None,
+        from_domain: None,
+    }
+}
+
+const fn reason(refusal: Refusal) -> &'static str {
+    match refusal {
+        Refusal::Malformed => "malformed headers",
+        Refusal::BadSignature => "bad signature",
+        Refusal::Expired => "timestamp outside the window",
+        Refusal::Replay => "nonce used before",
+    }
+}
+
+/// Logs why (never the message) and answers the same for every reason.
+fn refuse(device_id: &str, reason: &str) -> Response {
+    tracing::warn!(device = %device_id, reason, "bridge delivery refused");
+    bridge_reply(StatusCode::UNAUTHORIZED, "unauthorized")
+}
+
+fn bridge_reply(status: StatusCode, message: &str) -> Response {
+    (status, Json(serde_json::json!({ "error": message }))).into_response()
+}
+
 /// Revokes a device: the delivery endpoint refuses it from now on. The device's owner and workspace
 /// owners and admins can revoke it; for anyone else the device does not exist. Revoking a revoked
 /// device succeeds.
