+#[tokio::test]
+async fn every_vector_gets_the_status_it_expects() {
+    // one fresh server for each vector: the nonces are distinct, but the state must not matter
+    let names: Vec<String> = Vectors::load().0["vectors"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|vector| vector["name"].as_str().unwrap().to_owned())
+        .collect();
+    assert!(names.len() >= 13);
+    let fixture = Fixture::new().await;
+    for name in names {
+        let (request, expect) = fixture.vector(&name);
+        let status = fixture.post(&request).await;
+        assert_eq!(
+            status.as_u16(),
+            expect["status"].as_u64().unwrap() as u16,
+            "{name}"
+        );
+    }
+    // the 200 vectors stored a message each (the binary one too); no 401 stored anything
+    assert_eq!(fixture.receipts().await, 6);
+}
