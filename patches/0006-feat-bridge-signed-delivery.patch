@@ -0,0 +1,631 @@
+//! `POST /api/v1/mail/inbound/bridge/{device_id}`: signed delivery from a Worbit bridge device.
+//! The signing cases come from `tests/bridge-vectors.json` of the Worbit repository (the contract
+//! of `docs/bridge-signing.md`); the state-dependent cases (unknown, revoked, replay, size, off)
+//! are tested here directly.
+
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use axum::body::{Body, to_bytes};
+use axum::http::{Request, StatusCode, header};
+use base64::Engine as _;
+use base64::engine::general_purpose::STANDARD;
+use orbit_platform::{
+    AttachmentMutationCoordinator, Id, LocalBlobStore, MailMode, TestDatabase, TimestampMillis,
+    UploadLimits, UploadService,
+};
+use orbit_server::auth_routes::CookieMode;
+use orbit_server::mail_bridge::{BridgeRegistry, DeviceRecord, ensure_bridge_mailbox};
+use orbit_server::mail_routes::{MailSettings, MailState, mail_router};
+use orbit_server::repositories::identity::{IdentityRepository, SetupRequest};
+use orbit_server::repositories::instance_settings::InstanceSettingsRepository;
+use orbit_server::repositories::mail::MailRepository;
+use p256::ecdsa::signature::Signer as _;
+use p256::ecdsa::{Signature, SigningKey};
+use p256::pkcs8::DecodePrivateKey as _;
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+use tower::ServiceExt;
+
+const APP_KEY: [u8; 32] = [8; 32];
+const VECTORS: &str = include_str!("../../../../../tests/bridge-vectors.json");
+/// The second device of the vectors' "wrong device id" case.
+const OTHER_DEVICE: &str = "0f9e8d7c-6b5a-4c3d-9e2f-1a0b9c8d7e6f";
+
+struct Vectors(Value);
+
+impl Vectors {
+    fn load() -> Self {
+        Self(serde_json::from_str(VECTORS).unwrap())
+    }
+    fn text(&self, key: &str) -> String {
+        self.0[key].as_str().unwrap().to_owned()
+    }
+    fn now(&self) -> i64 {
+        self.0["now_unix"].as_i64().unwrap()
+    }
+    fn signing_key(&self) -> SigningKey {
+        let der = STANDARD
+            .decode(self.text("private_key_pkcs8_base64"))
+            .unwrap();
+        SigningKey::from_pkcs8_der(&der).unwrap()
+    }
+}
+
+struct Request2 {
+    path: String,
+    headers: Vec<(String, String)>,
+    body: Vec<u8>,
+}
+
+struct Fixture {
+    _root: tempfile::TempDir,
+    database: TestDatabase,
+    registry: Arc<BridgeRegistry>,
+    app: axum::Router,
+    vectors: Vectors,
+    workspace: Id,
+    owner_cookie: String,
+    owner_mailbox: Id,
+    other_mailbox: Id,
+    device: String,
+}
+
+impl Fixture {
+    async fn new() -> Self {
+        Self::with(true, true).await
+    }
+
+    async fn with(registry_on: bool, mail_on: bool) -> Self {
+        let vectors = Vectors::load();
+        let database = TestDatabase::new().await.unwrap();
+        let identity = Arc::new(IdentityRepository::new((*database).clone()));
+        let now = TimestampMillis::now();
+        identity
+            .store_setup_token(
+                "operator-secret",
+                TimestampMillis::from_millis(now.as_millis() + 60_000),
+            )
+            .await
+            .unwrap();
+        let setup = identity
+            .complete_setup(
+                SetupRequest {
+                    token: "operator-secret".to_owned(),
+                    email: "owner@example.com".to_owned(),
+                    display_name: "Owner".to_owned(),
+                    password_hash: "unused".to_owned(),
+                    workspace_name: "Orbit".to_owned(),
+                    project_name: "General".to_owned(),
+                },
+                now,
+            )
+            .await
+            .unwrap();
+        InstanceSettingsRepository::new((*database).clone())
+            .set_mail_enabled(setup.user_id, mail_on, "request", now)
+            .await
+            .unwrap();
+        let root = tempfile::tempdir().unwrap();
+        let uploads = UploadService::new(
+            (*database).clone(),
+            Arc::new(LocalBlobStore::new(root.path().join("attachments"))),
+            AttachmentMutationCoordinator::default(),
+            UploadLimits::default(),
+        );
+        let mail = Arc::new(MailRepository::new((*database).clone(), uploads, APP_KEY));
+        let registry = Arc::new(BridgeRegistry::new(
+            PathBuf::from(root.path()).join("devices.json"),
+        ));
+        let mut state = MailState::new(
+            Arc::clone(&identity),
+            Arc::clone(&mail),
+            CookieMode::secure(),
+            MailSettings {
+                enabled: false,
+                hostname: None,
+                mode: MailMode::Relay,
+            },
+        );
+        if registry_on {
+            state = state
+                .with_bridge(Arc::clone(&registry))
+                .with_bridge_clock(vectors.now());
+        }
+
+        // a second member with a device of their own (the same throwaway key)
+        let member = Id::new_v7();
+        let email = format!("{member}@example.com");
+        sqlx::query(
+            "INSERT INTO users (id, email, normalized_email, display_name, password_hash, created_at, updated_at) \
+             VALUES ($1, $2, $3, 'Member', 'unused', $4, $4)",
+        )
+        .bind(member.to_string())
+        .bind(&email)
+        .bind(&email)
+        .bind(now.as_millis())
+        .execute(database.pool())
+        .await
+        .unwrap();
+        sqlx::query(
+            "INSERT INTO memberships (id, workspace_id, user_id, role, version, created_at, updated_at) \
+             VALUES ($1, $2, $3, 'member', 0, $4, $4)",
+        )
+        .bind(Id::new_v7().to_string())
+        .bind(setup.workspace_id.to_string())
+        .bind(member.to_string())
+        .bind(now.as_millis())
+        .execute(database.pool())
+        .await
+        .unwrap();
+
+        let device = vectors.text("device_id");
+        let mut mailboxes = Vec::new();
+        for (user, device_id) in [(setup.user_id, device.as_str()), (member, OTHER_DEVICE)] {
+            let mailbox = ensure_bridge_mailbox(&database, setup.workspace_id, user)
+                .await
+                .unwrap();
+            registry
+                .add(DeviceRecord {
+                    device_id: device_id.to_owned(),
+                    workspace_id: setup.workspace_id,
+                    user_id: user,
+                    membership_id: mailbox.membership_id,
+                    mailbox_id: mailbox.mailbox_id,
+                    address_id: mailbox.address_id,
+                    name: "Test".to_owned(),
+                    public_key: vectors.text("public_key_spki_base64"),
+                    created_at: now.as_millis(),
+                    revoked_at: None,
+                })
+                .await
+                .unwrap();
+            mailboxes.push(mailbox.mailbox_id);
+        }
+        Self {
+            _root: root,
+            database,
+            registry,
+            app: mail_router(state),
+            workspace: setup.workspace_id,
+            owner_cookie: format!("__Host-orbit_session={}", setup.session.token),
+            owner_mailbox: mailboxes[0],
+            other_mailbox: mailboxes[1],
+            device,
+            vectors,
+        }
+    }
+
+    async fn post(&self, request: &Request2) -> StatusCode {
+        let mut builder = Request::builder().method("POST").uri(&request.path);
+        for (name, value) in &request.headers {
+            builder = builder.header(name, value);
+        }
+        let response = self
+            .app
+            .clone()
+            .oneshot(builder.body(Body::from(request.body.clone())).unwrap())
+            .await
+            .unwrap();
+        let status = response.status();
+        let bytes = to_bytes(response.into_body(), usize::MAX).await.unwrap();
+        // the same neutral body for every 401, and never message content
+        if status == StatusCode::UNAUTHORIZED {
+            assert_eq!(
+                String::from_utf8_lossy(&bytes),
+                r#"{"error":"unauthorized"}"#
+            );
+        }
+        status
+    }
+
+    /// The vector `name` as a request.
+    fn vector(&self, name: &str) -> (Request2, Value) {
+        let vector = self.vectors.0["vectors"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .find(|vector| vector["name"] == name)
+            .unwrap_or_else(|| panic!("no vector {name}"));
+        let headers = vector["headers"]
+            .as_object()
+            .unwrap()
+            .iter()
+            .map(|(name, value)| (name.clone(), value.as_str().unwrap().to_owned()))
+            .collect();
+        (
+            Request2 {
+                path: vector["path"].as_str().unwrap().to_owned(),
+                headers,
+                body: STANDARD
+                    .decode(vector["body_base64"].as_str().unwrap())
+                    .unwrap(),
+            },
+            vector["expect"].clone(),
+        )
+    }
+
+    /// A request for `device` signed with the vectors' key at `timestamp`.
+    fn signed(&self, device: &str, timestamp: i64, nonce: &str, body: &[u8]) -> Request2 {
+        let signed = format!(
+            "worbit-bridge-v1\n{timestamp}\n{nonce}\n{device}\n{:x}",
+            Sha256::digest(body)
+        );
+        let signature: Signature = self.vectors.signing_key().sign(signed.as_bytes());
+        Request2 {
+            path: format!("/api/v1/mail/inbound/bridge/{device}"),
+            headers: vec![
+                ("X-Worbit-Timestamp".to_owned(), timestamp.to_string()),
+                ("X-Worbit-Nonce".to_owned(), nonce.to_owned()),
+                (
+                    "X-Worbit-Signature".to_owned(),
+                    STANDARD.encode(signature.to_bytes()),
+                ),
+            ],
+            body: body.to_vec(),
+        }
+    }
+
+    fn now_signed(&self, nonce: &str, body: &[u8]) -> Request2 {
+        self.signed(&self.device, self.vectors.now(), nonce, body)
+    }
+
+    async fn count(&self, sql: &str) -> i64 {
+        sqlx::query_scalar(sqlx::AssertSqlSafe(sql.to_owned()))
+            .fetch_one(self.database.pool())
+            .await
+            .unwrap()
+    }
+
+    async fn receipts(&self) -> i64 {
+        self.count("SELECT COUNT(*) FROM mail_receipts").await
+    }
+
+    /// Runs the ingest of every pending receipt, as the job queue does.
+    async fn ingest_all(&self) {
+        let ids: Vec<String> = sqlx::query_scalar("SELECT id FROM mail_receipts ORDER BY id")
+            .fetch_all(self.database.pool())
+            .await
+            .unwrap();
+        let mail = {
+            let uploads = UploadService::new(
+                (*self.database).clone(),
+                Arc::new(LocalBlobStore::new(self._root.path().join("attachments"))),
+                AttachmentMutationCoordinator::default(),
+                UploadLimits::default(),
+            );
+            MailRepository::new((*self.database).clone(), uploads, APP_KEY)
+        };
+        for id in ids {
+            mail.ingest(id.parse().unwrap(), TimestampMillis::now())
+                .await
+                .unwrap();
+        }
+    }
+
+    /// The owner's view of a folder through the mail API.
+    async fn api(&self, path: &str) -> Value {
+        let response = self
+            .app
+            .clone()
+            .oneshot(
+                Request::builder()
+                    .uri(format!("/api/v1/workspaces/{}/mail{path}", self.workspace))
+                    .header(header::COOKIE, &self.owner_cookie)
+                    .body(Body::empty())
+                    .unwrap(),
+            )
+            .await
+            .unwrap();
+        assert_eq!(response.status(), StatusCode::OK, "{path}");
+        let bytes = to_bytes(response.into_body(), usize::MAX).await.unwrap();
+        serde_json::from_slice(&bytes).unwrap()
+    }
+
+    async fn threads(&self, mailbox: Id, folder: &str) -> Vec<Value> {
+        let page = self
+            .api(&format!("/threads?folder={folder}&mailbox_id={mailbox}"))
+            .await;
+        page["items"].as_array().unwrap().clone()
+    }
+}
