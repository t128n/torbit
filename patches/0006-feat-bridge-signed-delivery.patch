+#[tokio::test]
+async fn a_delivery_shows_in_the_inbox_with_its_attachment_and_bridge_origin() {
+    let fixture = Fixture::new().await;
+    let body = b"From: Ann <ann@sender.test>\r\nTo: Owner <owner@example.com>\r\n\
+Subject: Quarterly report\r\nMessage-ID: <q1@sender.test>\r\nMIME-Version: 1.0\r\n\
+Content-Type: multipart/mixed; boundary=\"b\"\r\n\r\n\
+--b\r\nContent-Type: text/plain\r\n\r\nThe numbers are attached.\r\n\
+--b\r\nContent-Type: application/pdf\r\nContent-Disposition: attachment; filename=\"report.pdf\"\r\n\
+Content-Transfer-Encoding: base64\r\n\r\nJVBERi0xLjQK\r\n--b--\r\n";
+    let status = fixture
+        .post(&fixture.now_signed("success-nonce-01", body))
+        .await;
+    assert_eq!(status, StatusCode::OK);
+    fixture.ingest_all().await;
+
+    let inbox = fixture.threads(fixture.owner_mailbox, "inbox").await;
+    assert_eq!(inbox.len(), 1, "{inbox:?}");
+    assert_eq!(inbox[0]["subject"], "Quarterly report");
+    assert!(
+        fixture
+            .threads(fixture.owner_mailbox, "spam")
+            .await
+            .is_empty()
+    );
+    let detail = fixture
+        .api(&format!("/threads/{}", inbox[0]["id"].as_str().unwrap()))
+        .await;
+    let message = &detail["messages"][0];
+    assert_eq!(message["from"]["address"], "ann@sender.test");
+    assert_eq!(
+        message["body_text"].as_str().unwrap().trim(),
+        "The numbers are attached."
+    );
+    assert_eq!(message["attachments"][0]["filename"], "report.pdf");
+    // neutral: no check ran, so there is no DMARC failure (and no pass either)
+    assert_eq!(message["auth"]["dmarc"], "none");
+    assert_eq!(message["auth"]["spf"], "none");
+    assert_eq!(message["auth"]["dkim"], "none");
+
+    // the origin is the bridge and the device
+    let (source, helo): (String, String) = sqlx::query_as("SELECT source, helo FROM mail_receipts")
+        .fetch_one(fixture.database.pool())
+        .await
+        .unwrap();
+    assert_eq!(source, "bridge");
+    assert!(helo.contains(&fixture.device), "{helo}");
+}
