+#[tokio::test]
+async fn a_response_with_its_own_policy_is_frameable_without_an_opener() {
+    // The sandboxed mail view document: its handler sets its own CSP, so the layer keeps it, and
+    // it must not carry `COOP: same-origin`, which forbids a nested browsing context from loading
+    // a response (the frame renders as a broken document). A plain response still isolates.
+    let app = Router::new()
+        .route(
+            "/api/v1/mail/content/token",
+            get(|| async {
+                (
+                    [("content-security-policy", "sandbox allow-scripts")],
+                    "<html></html>",
+                )
+            }),
+        )
+        .route("/probe", get(|| async { "plain" }))
+        .layer(HttpPlatformLayer::new(OriginPolicy::new(
+            "https://orbit.test",
+        )));
+
+    let document = app
+        .clone()
+        .oneshot(request("GET", "/api/v1/mail/content/token"))
+        .await
+        .unwrap();
+    assert_eq!(
+        document.headers()[CONTENT_SECURITY_POLICY],
+        "sandbox allow-scripts"
+    );
+    assert_eq!(
+        document.headers()["cross-origin-opener-policy"],
+        "unsafe-none"
+    );
+    assert_eq!(document.headers().get("x-frame-options"), None);
+
+    let plain = app.oneshot(request("GET", "/probe")).await.unwrap();
+    assert_eq!(plain.headers()["cross-origin-opener-policy"], "same-origin");
+}
