+    // The reading pane frames this document, so the platform layer must not send
+    // `same-origin`: a nested browsing context cannot load such a response.
+    let framed = app
+        .clone()
+        .layer(HttpPlatformLayer::new(OriginPolicy::new(ORIGIN)));
+    assert_eq!(
+        get(&framed, &url)
+            .await
+            .header("cross-origin-opener-policy"),
+        "unsafe-none"
+    );
