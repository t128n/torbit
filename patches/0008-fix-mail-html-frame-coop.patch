     if !handler_policy {
         headers.insert(X_FRAME_OPTIONS, HeaderValue::from_static("DENY"));
     }
+    // Nested browsing contexts must not load a `same-origin` response (HTML Living Standard), so
+    // the framed document gets `unsafe-none` like its CSP; its sandbox keeps the frame from
+    // reaching the app, and every other response still isolates its opener.
     headers.insert(
         HeaderName::from_static("cross-origin-opener-policy"),
-        HeaderValue::from_static("same-origin"),
