index 1a30e0d8..59488028 100644
--- a/apps/web/src/index.css
+++ b/apps/web/src/index.css
@@ -718,3 +718,19 @@ html .bn-mobile-formatting-toolbar {
   margin: revert-layer;
   padding: revert-layer;
 }
+
+/* Pele (pele.run) draws the Mermaid diagrams of code blocks and docs. It reads its colours
+   from `--pele-*` variables and references them live (`var()` inside the SVG), so a switch
+   of the app theme needs no second render. The variables map to the app colours on the root
+   of every picture (class `pele`); the series colours (pie slices, git branches) keep
+   Pele's defaults, where the app has no palette. Label plates sit on `--pele-bg`, which is
+   the page surface the docs editor draws on and the colour the chat card tints faintly. */
+.pele {
+    --pele-bg: var(--background);
+    --pele-fg: var(--foreground);
+    --pele-muted: var(--muted-foreground);
+    --pele-line: var(--foreground);
+    --pele-surface: var(--muted);
+    --pele-surface-alt: var(--secondary);
+    --pele-border: color-mix(in oklch, var(--foreground) 35%, transparent);
+}
