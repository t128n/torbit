+import { useEffect, useRef, useState } from 'react'
+import { Search4 } from 'reicon-react'
+import { Tip } from '@/components/common/Tip'
+import { InputGroup, InputGroupAddon, InputGroupInput } from '@/components/ui/input-group'
+import { Spinner } from '@/components/ui/spinner'
+import { searchGifs, trendingGifs, type GifItem } from '../../lib/gifClient'
+
+export interface GifPickerProps {
+  onPick: (gif: GifItem) => void
+}
+
+export function GifIcon(props: React.SVGProps<SVGSVGElement>) {
+  return (
+    <svg
+      viewBox="0 0 24 24"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth="1.5"
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      {...props}
+    >
+      <rect x="2.5" y="4.5" width="19" height="15" rx="3" />
+      <path d="M8.5 10H7C6.17 10 5.5 10.67 5.5 11.5V12.5C5.5 13.33 6.17 14 7 14H8.5V12H7" />
+      <path d="M12 10V14" />
+      <path d="M15.5 14V10H18.5" />
+      <path d="M15.5 12H17.5" />
+    </svg>
+  )
+}
+
+const POPULAR_CATEGORIES = [
+  'Trending',
+  'Yes',
+  'No',
+  'Dance',
+  'Celebrate',
+  'Applause',
+  'Laugh',
+  'Love',
+]
+
+/**
+ * The GIF picker panel of the composer: search input with category/trending previews
+ * and search results in a responsive scrollable grid.
+ */
+export function GifPicker({ onPick }: GifPickerProps) {
+  const [search, setSearch] = useState('')
+  const [gifs, setGifs] = useState<GifItem[]>([])
+  const [loading, setLoading] = useState(false)
+  const debounceTimer = useRef<ReturnType<typeof setTimeout> | null>(null)
+
+  useEffect(() => {
+    if (debounceTimer.current) {
+      clearTimeout(debounceTimer.current)
+    }
+
+    const query = search.trim()
+    debounceTimer.current = setTimeout(async () => {
+      setLoading(true)
+      try {
+        const result = query ? await searchGifs(query) : await trendingGifs()
+        setGifs(result.gifs)
+      } finally {
+        setLoading(false)
+      }
+    }, query ? 250 : 0)
+
+    return () => {
+      if (debounceTimer.current) {
+        clearTimeout(debounceTimer.current)
+      }
+    }
+  }, [search])
+
+  return (
+    <div
+      data-slot="gif-picker"
+      className="flex max-h-[380px] w-[344px] max-w-[calc(100vw-2rem)] flex-col"
+    >
+      <div className="p-2 pb-1.5">
+        <InputGroup className="border-0 bg-secondary/40 dark:bg-secondary/40">
+          <InputGroupAddon>
+            <Search4 />
+          </InputGroupAddon>
+          <InputGroupInput
+            autoFocus
+            type="search"
+            value={search}
+            placeholder="Search GIFs"
+            aria-label="Search GIFs"
+            autoComplete="off"
+            onChange={(event) => setSearch(event.target.value)}
+          />
+        </InputGroup>
+      </div>
+
+      <div
+        data-slot="gif-categories"
+        className="flex gap-1 overflow-x-auto px-2 pb-1.5 text-xs text-muted-foreground no-scrollbar"
+      >
+        {POPULAR_CATEGORIES.map((category) => {
+          const isSelected =
+            category === 'Trending' ? search === '' : search.toLowerCase() === category.toLowerCase()
+          return (
+            <button
+              key={category}
+              type="button"
+              className={`shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium transition-colors ${
+                isSelected
+                  ? 'bg-primary text-primary-foreground'
+                  : 'bg-muted/60 hover:bg-muted text-foreground'
+              }`}
+              onClick={() => setSearch(category === 'Trending' ? '' : category)}
+            >
+              {category}
+            </button>
+          )
+        })}
+      </div>
+
+      {loading && gifs.length === 0 ? (
+        <div className="flex h-36 items-center justify-center p-4">
+          <Spinner className="size-6 text-muted-foreground" />
+        </div>
+      ) : gifs.length > 0 ? (
+        <div
+          data-slot="gif-grid"
+          className="grid min-h-0 grid-cols-2 gap-1.5 overflow-y-auto overscroll-contain px-2 pb-2"
+        >
+          {gifs.map((gif) => (
+            <Tip key={gif.id} label={gif.title}>
+              <button
+                type="button"
+                data-slot="gif-button"
+                aria-label={gif.title}
+                className="group relative flex aspect-video w-full items-center justify-center overflow-hidden rounded-md bg-muted/40 outline-none hover:opacity-90 focus-visible:ring-3 focus-visible:ring-ring/50"
+                onClick={() => onPick(gif)}
+              >
+                <img
+                  src={gif.previewUrl || gif.url}
+                  alt={gif.title}
+                  draggable={false}
+                  loading="lazy"
+                  className="size-full object-cover transition-transform group-hover:scale-105"
+                />
+              </button>
+            </Tip>
+          ))}
+        </div>
+      ) : (
+        <p className="px-3 pb-3 text-sm text-muted-foreground">No GIFs match</p>
+      )}
+    </div>
+  )
+}
