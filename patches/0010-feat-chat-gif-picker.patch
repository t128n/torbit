@@ -0,0 +1,139 @@
+import { afterEach, beforeEach, expect, test } from 'bun:test'
+import { render, screen, waitFor } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { GifPicker } from './GifPicker'
+import type { GifItem } from '../../lib/gifClient'
+
+const realFetch = globalThis.fetch
+
+const mockGifs: GifItem[] = [
+  {
+    id: 'gif-1',
+    title: 'Happy Cat',
+    url: 'https://media.test/cat.gif',
+    previewUrl: 'https://media.test/cat-preview.gif',
+    width: 200,
+    height: 200,
+  },
+  {
+    id: 'gif-2',
+    title: 'Dancing Dog',
+    url: 'https://media.test/dog.gif',
+    previewUrl: 'https://media.test/dog-preview.gif',
+    width: 200,
+    height: 200,
+  },
+]
+
+beforeEach(() => {
+  globalThis.fetch = (async (input: RequestInfo | URL) => {
+    const url = input.toString()
+    if (url.includes('search')) {
+      if (url.includes('q=empty')) {
+        return new Response(JSON.stringify({ results: [] }), {
+          status: 200,
+          headers: { 'Content-Type': 'application/json' },
+        })
+      }
+      return new Response(
+        JSON.stringify({
+          results: [
+            {
+              id: 'gif-search-1',
+              content_description: 'Searched Dancing Dog',
+              media_formats: {
+                gif: { url: 'https://media.test/search-dog.gif' },
+                tinygif: { url: 'https://media.test/search-dog-preview.gif' },
+              },
+            },
+          ],
+        }),
+        {
+          status: 200,
+          headers: { 'Content-Type': 'application/json' },
+        },
+      )
+    }
+
+    // Default trending
+    return new Response(
+      JSON.stringify({
+        results: [
+          {
+            id: mockGifs[0].id,
+            content_description: mockGifs[0].title,
+            media_formats: {
+              gif: { url: mockGifs[0].url },
+              tinygif: { url: mockGifs[0].previewUrl },
+            },
+          },
+          {
+            id: mockGifs[1].id,
+            content_description: mockGifs[1].title,
+            media_formats: {
+              gif: { url: mockGifs[1].url },
+              tinygif: { url: mockGifs[1].previewUrl },
+            },
+          },
+        ],
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      },
+    )
+  }) as unknown as typeof fetch
+})
+
+afterEach(() => {
+  globalThis.fetch = realFetch
+})
+
+test('renders search input and initial trending gifs', async () => {
+  render(<GifPicker onPick={() => {}} />)
+
+  expect(screen.getByPlaceholderText('Search GIFs')).toBeDefined()
+
+  await waitFor(() => {
+    expect(screen.getByLabelText('Happy Cat')).toBeDefined()
+    expect(screen.getByLabelText('Dancing Dog')).toBeDefined()
+  })
+})
+
+test('selecting a gif calls onPick with the chosen gif item', async () => {
+  const picked: GifItem[] = []
+  render(<GifPicker onPick={(gif) => picked.push(gif)} />)
+
+  const catBtn = await screen.findByLabelText('Happy Cat')
+  await userEvent.click(catBtn)
+
+  expect(picked.length).toBe(1)
+  expect(picked[0].id).toBe('gif-1')
+  expect(picked[0].url).toBe('https://media.test/cat.gif')
+})
+
+test('searching updates the displayed gifs', async () => {
+  render(<GifPicker onPick={() => {}} />)
+
+  await screen.findByLabelText('Happy Cat')
+
+  const input = screen.getByPlaceholderText('Search GIFs')
+  await userEvent.type(input, 'dog')
+
+  await waitFor(() => {
+    expect(screen.getByLabelText('Searched Dancing Dog')).toBeDefined()
+  })
+})
+
+test('shows empty state when no results match query', async () => {
+  render(<GifPicker onPick={() => {}} />)
+
+  await screen.findByLabelText('Happy Cat')
+
+  const input = screen.getByPlaceholderText('Search GIFs')
+  await userEvent.type(input, 'empty')
+
+  await waitFor(() => {
+    expect(screen.getByText('No GIFs match')).toBeDefined()
+  })
+})
