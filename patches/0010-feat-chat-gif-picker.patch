@@ -0,0 +1,211 @@
+export interface GifItem {
+  id: string
+  title: string
+  url: string
+  previewUrl: string
+  embedUrl?: string
+  width?: number
+  height?: number
+}
+
+export interface GifSearchResult {
+  gifs: GifItem[]
+  next?: string
+}
+
+export type GifProvider = 'tenor' | 'giphy' | 'custom'
+
+export interface GifConfig {
+  provider: GifProvider
+  apiKey?: string
+  endpoint?: string
+}
+
+export interface SearchGifsOptions {
+  limit?: number
+  next?: string
+  config?: Partial<GifConfig>
+}
+
+// Tenor web client key and official public browser API key
+const DEFAULT_CLIENT_KEY = 'tenor_web'
+const DEFAULT_TENOR_API_KEY = 'AIzaSyCZt6SSh5VgVPzD9fhyzG1DprdPRhtoaR4'
+
+export function getGifConfig(override?: Partial<GifConfig>): GifConfig {
+  const provider = (override?.provider ||
+    import.meta.env?.VITE_ORBIT_GIF_PROVIDER ||
+    'tenor') as GifProvider
+  const apiKey =
+    override?.apiKey ||
+    import.meta.env?.VITE_ORBIT_GIF_API_KEY ||
+    (provider === 'tenor' ? DEFAULT_TENOR_API_KEY : undefined)
+  const endpoint = override?.endpoint || import.meta.env?.VITE_ORBIT_GIF_ENDPOINT
+
+  return { provider, apiKey, endpoint }
+}
+
+function parseGiphyItems(data: any): { gifs: GifItem[]; next?: string } {
+  const gifs: GifItem[] = (data.data || []).map((item: any) => ({
+    id: item.id,
+    title: item.title || 'GIF',
+    url: item.images?.original?.url || item.url,
+    previewUrl:
+      item.images?.fixed_width_small?.url ||
+      item.images?.preview_gif?.url ||
+      item.images?.original?.url,
+    embedUrl: item.url || item.images?.original?.url,
+    width: item.images?.original?.width
+      ? parseInt(item.images.original.width, 10)
+      : undefined,
+    height: item.images?.original?.height
+      ? parseInt(item.images.original.height, 10)
+      : undefined,
+  }))
+
+  const next =
+    data.pagination &&
+    data.pagination.offset + data.pagination.count < data.pagination.total_count
+      ? String(data.pagination.offset + data.pagination.count)
+      : undefined
+
+  return { gifs, next }
+}
+
+function parseTenorItems(data: any): { gifs: GifItem[]; next?: string } {
+  const gifs: GifItem[] = (data.results || []).map((item: any) => {
+    const gif = item.media_formats?.gif || item.media?.[0]?.gif
+    const tiny =
+      item.media_formats?.tinygif ||
+      item.media?.[0]?.tinygif ||
+      item.media_formats?.nanogif ||
+      gif
+    return {
+      id: item.id,
+      title: item.content_description || item.title || 'GIF',
+      url: gif?.url,
+      previewUrl: tiny?.url || gif?.url,
+      embedUrl: item.itemurl || item.url || gif?.url,
+      width: gif?.dims?.[0],
+      height: gif?.dims?.[1],
+    }
+  })
+
+  return { gifs, next: data.next }
+}
+
+function parseCustomItems(data: any): { gifs: GifItem[]; next?: string } {
+  const list = data.results || data.gifs || data.data || []
+  const gifs: GifItem[] = list.map((item: any) => ({
+    id: String(item.id),
+    title: item.title || item.content_description || 'GIF',
+    url: item.url || item.media_formats?.gif?.url || item.images?.original?.url,
+    previewUrl:
+      item.previewUrl ||
+      item.preview_url ||
+      item.media_formats?.tinygif?.url ||
+      item.url,
+    embedUrl: item.itemurl || item.url || item.media_formats?.gif?.url,
+    width: item.width,
+    height: item.height,
+  }))
+
+  return { gifs, next: data.next }
+}
+
+interface ProviderAdapter {
+  buildUrl: (
+    type: 'search' | 'trending',
+    query: string | undefined,
+    config: GifConfig,
+    limit: number,
+    next?: string,
+  ) => string
+  parse: (data: any) => { gifs: GifItem[]; next?: string }
+}
+
+const GIPHY_ADAPTER: ProviderAdapter = {
+  buildUrl(type, query, config, limit, next) {
+    const base = config.endpoint || 'https://api.giphy.com/v1/gifs'
+    const url = new URL(type === 'search' ? `${base}/search` : `${base}/trending`)
+    if (query) url.searchParams.set('q', query)
+    if (config.apiKey) url.searchParams.set('api_key', config.apiKey)
+    url.searchParams.set('limit', String(limit))
+    if (next) url.searchParams.set('offset', next)
+    return url.toString()
+  },
+  parse: parseGiphyItems,
+}
+
+const TENOR_ADAPTER: ProviderAdapter = {
+  buildUrl(type, query, config, limit, next) {
+    const base = config.endpoint || 'https://tenor.googleapis.com/v2'
+    const url = new URL(type === 'search' ? `${base}/search` : `${base}/featured`)
+    if (query) url.searchParams.set('q', query)
+    if (config.apiKey) url.searchParams.set('key', config.apiKey)
+    url.searchParams.set('client_key', DEFAULT_CLIENT_KEY)
+    url.searchParams.set('limit', String(limit))
+    if (next) url.searchParams.set('pos', next)
+    return url.toString()
+  },
+  parse: parseTenorItems,
+}
+
+const CUSTOM_ADAPTER: ProviderAdapter = {
+  buildUrl(type, query, config, limit, next) {
+    const url = new URL(config.endpoint ? (type === 'search' ? config.endpoint : `${config.endpoint}/trending`) : '')
+    if (query) url.searchParams.set('q', query)
+    url.searchParams.set('limit', String(limit))
+    if (next) url.searchParams.set('pos', next)
+    if (config.apiKey) url.searchParams.set('key', config.apiKey)
+    return url.toString()
+  },
+  parse: parseCustomItems,
+}
+
+function getAdapter(provider: GifProvider, endpoint?: string): ProviderAdapter {
+  if (provider === 'giphy') return GIPHY_ADAPTER
+  if (provider === 'custom' && endpoint) return CUSTOM_ADAPTER
+  return TENOR_ADAPTER
+}
+
+export async function searchGifs(
+  query: string,
+  options?: SearchGifsOptions,
+): Promise<GifSearchResult> {
+  const q = query.trim()
+  if (!q) {
+    return trendingGifs(options)
+  }
+
+  const config = getGifConfig(options?.config)
+  const limit = options?.limit ?? 24
+  const adapter = getAdapter(config.provider, config.endpoint)
+
+  try {
+    const targetUrl = adapter.buildUrl('search', q, config, limit, options?.next)
+    const response = await fetch(targetUrl)
+    if (!response.ok) return { gifs: [] }
+    const data = await response.json()
+    return adapter.parse(data)
+  } catch {
+    return { gifs: [] }
+  }
+}
+
+export async function trendingGifs(
+  options?: SearchGifsOptions,
+): Promise<GifSearchResult> {
+  const config = getGifConfig(options?.config)
+  const limit = options?.limit ?? 24
+  const adapter = getAdapter(config.provider, config.endpoint)
+
+  try {
+    const targetUrl = adapter.buildUrl('trending', undefined, config, limit, options?.next)
+    const response = await fetch(targetUrl)
+    if (!response.ok) return { gifs: [] }
+    const data = await response.json()
+    return adapter.parse(data)
+  } catch {
+    return { gifs: [] }
+  }
+}
